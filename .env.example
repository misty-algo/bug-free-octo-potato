# Docker Compose 环境变量样例
#
# 用法：复制为 .env 后填入真值。.env 已被 .gitignore 忽略，MUST NOT 提交。
#
#   cp .env.example .env
#   docker compose up -d --build
#
# 不建 .env 也能起（下面都有本地开发兜底值），但生产 MUST 填真值。

# ---------- JWT 签发密钥 ----------
# gateway 与 passenger 共用同一个密钥，否则一边签的令牌另一边验不过。
# 建议 32 字节以上随机串。
PASSENGER_TOKEN_SECRET=local-dev-secret-change-me

# ---------- 手机号加密密钥 ----------
# 乘客端账号手机号落库用 AES-256-GCM，密钥长度 MUST 是 16、24 或 32 字节。
# 缺失时 passenger 进程会直接退出，不会用兜底密钥（兜底等于没加密）。
PASSENGER_PHONE_KEY=0123456789abcdef0123456789abcdef

# ---------- MongoDB ----------
# compose 里的 mongodb 服务用 bw / bw-secret 初始化，改这里要同步改
# docker-compose.yml 里 mongodb 服务的 MONGO_INITDB_ROOT_*。
# 连线上库时把这三项指向线上地址即可，容器内服务名不适用。
MONGODB_URI=mongodb://mongodb:27017
MONGODB_USERNAME=bw
MONGODB_PASSWORD=bw-secret
MONGODB_DATABASE=huaxiaozhu
